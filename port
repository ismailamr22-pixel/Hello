    bidirectional: true,
    alignment: AlignmentType.RIGHT,
    children: [new TextRun({ text, bold, size: 22, color, font: "Arial", rightToLeft: true })],
  });
}

function bulletItem(text, ref = "bullets") {
  return new Paragraph({
    numbering: { reference: ref, level: 0 },
    spacing: { before: 50, after: 50 },
    children: [new TextRun({ text, size: 22, font: "Arial", color: DARK })],
  });
}

function bulletItemRTL(text, ref = "bulletsRTL") {
  return new Paragraph({
    numbering: { reference: ref, level: 0 },
    spacing: { before: 50, after: 50 },
    bidirectional: true,
    alignment: AlignmentType.RIGHT,
    children: [new TextRun({ text, size: 22, font: "Arial", color: DARK, rightToLeft: true })],
  });
}

function spacer(lines = 1) {
  return new Paragraph({ spacing: { before: 0, after: lines * 100 }, children: [new TextRun("")] });
}

function colorBanner(text, bg = BLUE, fg = WHITE, size = 30) {
  return new Paragraph({
    shading: { fill: bg, type: ShadingType.CLEAR },
    spacing: { before: 160, after: 160 },
    indent: { left: 200, right: 200 },
    children: [new TextRun({ text, bold: true, size, color: fg, font: "Arial" })],
  });
}

function colorBannerRTL(text, bg = BLUE, fg = WHITE, size = 30) {
