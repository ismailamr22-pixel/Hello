function heading1(text, color = WHITE, align = AlignmentType.LEFT) {
  return new Paragraph({
    spacing: { before: 0, after: 120 },
    children: [new TextRun({ text, bold: true, size: 36, color, font: "Arial" })],
    alignment: align,
  });
}

function heading2(text, color = BLUE) {
  return new Paragraph({
    spacing: { before: 280, after: 100 },
    border: { bottom: { style: BorderStyle.SINGLE, size: 4, color: MID_BLUE, space: 4 } },
    children: [new TextRun({ text, bold: true, size: 28, color, font: "Arial" })],
  });
}

function heading2RTL(text, color = BLUE) {
  return new Paragraph({
    spacing: { before: 280, after: 100 },
    border: { bottom: { style: BorderStyle.SINGLE, size: 4, color: MID_BLUE, space: 4 } },
    bidirectional: true,
    alignment: AlignmentType.RIGHT,
    children: [new TextRun({ text, bold: true, size: 28, color, font: "Arial", rightToLeft: true })],
  });
}

function body(text, bold = false, color = DARK) {
  return new Paragraph({
    spacing: { before: 60, after: 60 },
    children: [new TextRun({ text, bold, size: 22, color, font: "Arial" })],
  });
}

function bodyRTL(text, bold = false, color = DARK) {
  return new Paragraph({
