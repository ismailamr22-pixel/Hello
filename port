    shading: { fill: bg, type: ShadingType.CLEAR },
    spacing: { before: 160, after: 160 },
    indent: { left: 200, right: 200 },
    bidirectional: true,
    alignment: AlignmentType.RIGHT,
    children: [new TextRun({ text, bold: true, size, color: fg, font: "Arial", rightToLeft: true })],
  });
}

function skillTagTable(tags) {
  // Split into rows of 3
  const rows = [];
  for (let i = 0; i < tags.length; i += 3) {
    const cells = tags.slice(i, i + 3).map(tag =>
      new TableCell({
        borders: noBorders,
        shading: { fill: LIGHT_BLUE, type: ShadingType.CLEAR },
        margins: { top: 80, bottom: 80, left: 120, right: 120 },
        width: { size: 3120, type: WidthType.DXA },
        children: [new Paragraph({
          alignment: AlignmentType.CENTER,
          children: [new TextRun({ text: tag, bold: true, size: 20, color: BLUE, font: "Arial" })]
        })]
      })
    );
    // Pad to 3 cells
    while (cells.length < 3) {
      cells.push(new TableCell({
        borders: noBorders,
        width: { size: 3120, type: WidthType.DXA },
        children: [new Paragraph({ children: [new TextRun("")] })]
      }));
    }
    rows.push(new TableRow({ children: cells }));
  }
  return new Table({
    width: { size: 9360, type: WidthType.DXA },
    columnWidths: [3120, 3120, 3120],
    rows,
  });
}

